{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }],
      "destination": "https://www.lumminalaw.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "lumminalaw.com" }],
      "destination": "https://www.lumminalaw.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "lumminalp.com" }],
      "destination": "https://www.lumminalaw.com/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.lumminalp.com" }],
      "destination": "https://www.lumminalaw.com/$1",
      "statusCode": 301
    },
    {
      "source": "/Insights",
      "destination": "/insights",
      "statusCode": 301
    },
    {
      "source": "/Insights/:path*",
      "destination": "/insights/:path*",
      "statusCode": 301
    },
    {
      "source": "/Insight",
      "destination": "/insights",
      "statusCode": 301
    },
    {
      "source": "/About/",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/About",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/Practice-Areas",
      "destination": "/practice-areas",
      "statusCode": 301
    },
    {
      "source": "/PracticeAreas",
      "destination": "/practice-areas",
      "statusCode": 301
    },
    {
      "source": "/Practiceareas",
      "destination": "/practice-areas",
      "statusCode": 301
    },
    {
      "source": "/Attorneys",
      "destination": "/attorneys",
      "statusCode": 301
    },
    {
      "source": "/Our-Team",
      "destination": "/our-team",
      "statusCode": 301
    },
    {
      "source": "/OurTeam",
      "destination": "/our-team",
      "statusCode": 301
    },
    {
      "source": "/Results",
      "destination": "/results",
      "statusCode": 301
    },
    {
      "source": "/Consultation",
      "destination": "/consultation",
      "statusCode": 301
    },
    {
      "source": "/Contact",
      "destination": "/consultation",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/consultation",
      "statusCode": 301
    },
    {
      "source": "/book",
      "destination": "/consultation",
      "statusCode": 301
    },
    {
      "source": "/Book",
      "destination": "/consultation",
      "statusCode": 301
    },
    {
      "source": "/Services",
      "destination": "/practice-areas",
      "statusCode": 301
    },
    {
      "source": "/Services/:path*",
      "destination": "/services/:path*",
      "statusCode": 301
    },
    {
      "source": "/services",
      "destination": "/practice-areas",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
